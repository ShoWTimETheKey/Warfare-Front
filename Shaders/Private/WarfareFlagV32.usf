// Independent bounded, cloth-sized impacts: no vertical reveal or scrolling mask.
#include "/Engine/Public/Platform.ush"
Texture2D FlagCloth; SamplerState FlagClothSampler;
Texture2D Absorption; SamplerState AbsorptionSampler;
Texture2D Spill; SamplerState SpillSampler;
float4 StainState; // displayed, target, previous losses; arrival age
float ClothTime, SplatterSeed;
float Hash21(float2 p) { return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
float Splat(float2 p,float2 centre,float radius,float spin,float salt,float fibres)
{
    float2 d=(p-centre)*float2(1,.68);
    float sn=sin(spin),cs=cos(spin);
    d=float2(cs*d.x-sn*d.y,sn*d.x+cs*d.y)*float2(.77,1.2);
    // Original liquid-transfer atlas: opaque pools, tapered run-outs and
    // satellite droplets. Rotating four unrelated imprints avoids rosette shapes.
    float2 q=d/max(radius*3.7,.001)+.5;
    float bounded=step(0,q.x)*step(q.x,1)*step(0,q.y)*step(q.y,1);
    float index=floor(frac(salt*.317)*4);
    float2 tile=float2(fmod(index,2),floor(index/2));
    float2 sampleUV=(tile+clamp(q,.004,.996))*.5;
    float liquid=Spill.SampleLevel(SpillSampler,sampleUV,0).r;
    return smoothstep(.014,.83,liquid)*bounded*(.84+.16*fibres);
}
void Main(in float2 TextureCoordinate:TEXCOORD0,out float4 OutColor:SV_Target0)
{
    float2 uv=TextureCoordinate;
    uv.y+=sin(uv.x*11-ClothTime*.85)*.005*uv.x;uv=clamp(uv,.001,.999);
    float3 cloth=FlagCloth.Sample(FlagClothSampler,uv).rgb;
    float fibres=Absorption.Sample(AbsorptionSampler,frac(uv*float2(1.13,1.17)+SplatterSeed*.013)).r;
    float losses=max(0,StainState.x),age=max(0,StainState.w);
    float cover=0,wetCover=0,arrival=0;
    [unroll] for(int i=0;i<18;++i)
    {
        float2 salt=float2(i*5.17+SplatterSeed,i*1.73+SplatterSeed*.61);
        float r=Hash21(salt),r2=Hash21(salt+31.1),r3=Hash21(salt+79.7);
        float2 centre=float2(.07+.86*r,.08+.84*r2);
        float threshold=1+i*(4.2+i*.34);
        float deposited=saturate((losses-threshold)/5.5);
        float old=saturate((StainState.z-threshold)/5.5);
        float target=saturate((StainState.y-threshold)/5.5);
        float fresh=saturate(target-old);
        float baseRadius=.045+.075*r3;
        float settled=Splat(uv,centre,baseRadius*(.60+.40*deposited),r*6.283,r2*19,fibres)*deposited;
        [unroll] for(int k=0;k<3;++k)
        {
            float h=Hash21(salt+float2(k*17.3,93.2));
            float angle=r*6.283+(k-1)*.7;
            float2 offset=float2(cos(angle),sin(angle)/.68)*(baseRadius*(1.3+.9*h));
            float2 dd=(uv-centre-offset)*float2(1,.68);
            settled=max(settled,(1-smoothstep(.003+h*.006,.006+h*.007,length(dd)))*deposited);
        }
        // Expanding oblique impact meets the same deposited silhouette. Only
        // newly gained coverage gets the wet pulse; older splashes never reset.
        float travel=saturate((age-.018)/.19);
        float strike=Splat(uv,centre,baseRadius*(.2+.8*sqrt(travel)),r*6.283,r2*19,fibres)*fresh;
        float splash=strike*(1-smoothstep(.12,.42,age))*smoothstep(0,.035,age);
        cover=max(cover,settled);arrival=max(arrival,splash);
        wetCover=max(wetCover,strike*(1-smoothstep(.24,1.3,age)));
    }
    float luma=dot(cloth,float3(.2126,.7152,.0722));
    float fold=.93+.045*sin(uv.x*19+uv.y*4)+.018*sin(uv.x*43-uv.y*7);
    float grit=Hash21(floor(uv*float2(310,205))+SplatterSeed);
    float soil=saturate((.43-fibres)*1.8+.16*sin(uv.x*39+uv.y*24)+.14*grit);
    float3 dry=float3(.028,.0020,.0025)*(.73+.35*luma+.12*fibres);
    float3 wet=float3(.059,.0043,.0048)*(.74+.29*luma);
    float3 mud=float3(.029,.022,.014)*(.65+.55*grit);
    float3 blood=lerp(lerp(dry,wet,saturate(wetCover*.65+arrival*.75)),mud,soil*.53);
    float3 color=lerp(cloth*.83,blood,saturate(max(cover,arrival)*.985))*fold;
    float2 grid=float2(7,4),cell=floor(uv*grid);
    float h=Hash21(cell+13.7+SplatterSeed),j=Hash21(cell+39.1+SplatterSeed);
    float2 centre=(cell+float2(.18+.64*h,.18+.64*j))/grid;
    float growth=saturate((losses-(14+Hash21(cell+81.4+SplatterSeed)*130))/38);
    float2 delta=(uv-centre)*float2(1,.67);
    float angle=atan2(delta.y,delta.x);
    float irregular=1+.08*sin(angle*3+h*23)+.055*sin(angle*7+j*31);
    float signedDistance=length(delta)-growth*(.010+.012*j)*irregular;
    float aa=max(fwidth(signedDistance),.0007);
    float alpha=lerp(1,smoothstep(-aa,aa,signedDistance),smoothstep(0,.04,growth));
    float severity=saturate((losses-25)/140);
    float fringe=severity*(.019+.034*pow(.5+.5*sin(uv.y*37+SplatterSeed+.7*sin(uv.y*93)),3));
    float edgeDistance=(1-uv.x)-fringe,edgeAA=max(fwidth(edgeDistance),.0007);
    alpha*=smoothstep(-edgeAA,edgeAA,edgeDistance);
    float hem=severity*.009*(.3+.7*Hash21(floor(uv*float2(97,1))+SplatterSeed));
    alpha*=smoothstep(-edgeAA,edgeAA,min(uv.y,1-uv.y)-hem*uv.x);
    float tornRim=(1-smoothstep(.0008,.0048,abs(signedDistance)))*smoothstep(0,.04,growth);
    color=lerp(color,float3(.037,.026,.014),tornRim*.69);
    float3 encoded=lerp(color*12.92,1.055*pow(max(color,0),1.0/2.4)-.055,step(.0031308,color));
    OutColor=float4(saturate(encoded),saturate(alpha));
}
