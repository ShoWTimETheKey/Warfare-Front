    {TEXT("中央阵地与敌军纵深防线已被我军夺取。"), TEXT("Our troops have secured the centre and both enemy trench lines."), TEXT("Our troops have secured the centre and both enemy trench lines.")},
    {TEXT("敌军夺取了中央阵地与我军纵深防线。"), TEXT("The enemy has secured the centre and both of our trench lines."), TEXT("敌军夺取了中央阵地与我军纵深防线。")},
    {TEXT("敌军夺取了中央阵地与我军纵深防线。"), TEXT("The enemy has secured the centre and both of our trench lines."), TEXT("The enemy has secured the centre and both of our trench lines.")},
