inline bool ValidateComponent(const FString& Scene,const UStaticMeshComponent* Component)
{
    if(!Enabled(Scene)||!Component||!Component->ComponentHasTag(TEXT("FRRU_V826Woodline"))
        ||!Component->IsRegistered()||Component->GetCollisionEnabled()!=ECollisionEnabled::NoCollision)return false;
    const auto* Instances=Cast<UHierarchicalInstancedStaticMeshComponent>(Component);
    const UStaticMesh* Mesh=Component->GetStaticMesh();if(!Instances||!Mesh)return false;
    int32 Index=INDEX_NONE;for(int32 I=0;I<5;++I)if(Mesh->GetPathName()==MeshPaths[I]){Index=I;break;}
    if(Index==INDEX_NONE)return false;
    int32 ExpectedInstances=0;for(const auto& P:Placements)ExpectedInstances+=P.Mesh==Index;
    if(Instances->GetInstanceCount()!=ExpectedInstances)return false;
    for(int32 Slot=0;Slot<Component->GetNumMaterials();++Slot)
    {
        const auto* Material=Component->GetMaterial(Slot);bool Matched=false;
        for(const auto& Contract:Materials)if(Contract.Mesh==Index&&Mesh->GetStaticMaterials()[Slot].MaterialSlotName==FName(Contract.Slot)
            &&Material&&Material->GetPathName()==Contract.Path){Matched=true;break;}
        if(!Matched)return false;
    }
    return true;
}
inline bool Stage(AActor* Owner,USceneComponent* Root,const FString& SceneId,FString& Error)
{
    if(!Enabled(SceneId))return true;
    const auto* Native=wfexp::scene::ForMission("fr.malmaison");
    if(!Owner||!Root||Owner->GetRootComponent()!=Root||!Native||Native->revision!=1||Native->heightCount!=131841)
    {Error=TEXT("woodline native/root identity mismatch");return false;}
    uint64 Hash=14695981039346656037ull;
    for(std::size_t I=0;I<Native->heightCount;++I)
    {const uint16 V=static_cast<uint16>(Native->heightsCm[I]);Hash=(Hash^uint8(V))*1099511628211ull;Hash=(Hash^uint8(V>>8))*1099511628211ull;}
    if(Hash!=1417540245652055815ull){Error=TEXT("woodline requires its verified active native terrain");return false;}
    UStaticMesh* Meshes[5]={};
    for(int32 I=0;I<5;++I)
    {
        Meshes[I]=LoadObject<UStaticMesh>(nullptr,MeshPaths[I]);
        if(!Meshes[I]||!Meshes[I]->GetRenderData()||Meshes[I]->GetStaticMaterials().IsEmpty())
        {Error=TEXT("retained woodline mesh/material missing");return false;}
        const FBox Bounds=Meshes[I]->GetBoundingBox();
        if(!Bounds.Min.Equals(ExpectedBounds[I].Min,.05)||!Bounds.Max.Equals(ExpectedBounds[I].Max,.05))
        {Error=TEXT("retained woodline actual mesh basis/bounds differ");return false;}
        for(const auto& Slot:Meshes[I]->GetStaticMaterials())
        {
            bool Matched=false;for(const auto& Contract:Materials)
                if(Contract.Mesh==I&&Slot.MaterialSlotName==FName(Contract.Slot)&&Slot.MaterialInterface&&Slot.MaterialInterface->GetMaterial()
                    &&Slot.MaterialInterface->GetPathName()==Contract.Path){Matched=true;break;}
            if(!Matched){Error=TEXT("retained woodline material differs");return false;}
        }
    }
    // Check the complete independently measured bearing foundation before
    // creating any component. No false success or partial woodline mutation.
    for(const auto& P:Placements)for(int32 J=0;J<P.BearingCount;++J)
    {
        const auto& B=Bearings[P.FirstBearing+J];const FVector W=P.World.TransformPosition(B.Local);
        double H=0;if(!wfexp::scene::HeightAt(*Native,W.X,W.Y,H)||FMath::Abs(H-B.NativeHeight)>.001||W.Z>H-2.999)
        {Error=TEXT("woodline measured bearing contact differs");return false;}
    }
    UHierarchicalInstancedStaticMeshComponent* Components[5]={};
    for(int32 I=0;I<5;++I)
    {
        auto* C=NewObject<UHierarchicalInstancedStaticMeshComponent>(Owner,FName(*FString::Printf(TEXT("MalmaisonWoodlineV826_%d"),I)),RF_Transient);
        Owner->AddInstanceComponent(C);C->SetupAttachment(Root);C->SetMobility(EComponentMobility::Movable);C->SetStaticMesh(Meshes[I]);
        C->SetCollisionProfileName(TEXT("NoCollision"));C->SetCollisionEnabled(ECollisionEnabled::NoCollision);C->SetGenerateOverlapEvents(false);C->SetCanEverAffectNavigation(false);
        C->ComponentTags.Add(TEXT("FRRU_V826Woodline"));C->RegisterComponent();Components[I]=C;
    }
    for(const auto& P:Placements)Components[P.Mesh]->AddInstance(P.World.GetRelativeTransform(Owner->GetActorTransform()));
    for(const auto* C:Components)if(!ValidateComponent(SceneId,C)){Error=TEXT("woodline staging contract failed");return false;}
    return true;
}
