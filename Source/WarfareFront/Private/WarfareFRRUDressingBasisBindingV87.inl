inline bool Enabled()
{
#if WITH_EDITOR
    if(FParse::Param(FCommandLine::Get(),TEXT("WFFRRUV87OriginalDressingBasis"))
        &&FParse::Param(FCommandLine::Get(),TEXT("WFFRRUV82WorldReview"))
        &&FParse::Param(FCommandLine::Get(),TEXT("WFRenderNoSave")))return false;
#endif
    // All sixty copies passed exact geometry/material/UV/collision comparisons
    // and actual render-basis readback. Only invalid source basis regions changed.
    return true;
}
inline FString Resolve(const FString& Original)
{
    if(Enabled())for(const auto& Entry:Entries)if(Original==Entry.Original)return Entry.Candidate;
    return Original;
}
inline FString OriginalPath(const FString& Bound)
{
    if(Enabled())for(const auto& Entry:Entries)if(Bound==Entry.Candidate)return Entry.Original;
    return Bound;
}
inline bool RegisteredCandidate(const FString& Bound,const FString& Scene)
{
    if(Enabled())for(const auto& Entry:Entries)if(Bound==Entry.Candidate&&Scene==Entry.Scene)return true;
    return false;
}
