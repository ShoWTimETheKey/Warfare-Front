static const FAuthoredV41 AuthoredV41[] = {
    {TEXT("arras"),TEXT("斯卡尔普河的晨雾"),TEXT("雪幕后面的枪口"),TEXT("阿拉斯的炮声穿过雨雪，英军正向德军前沿推进。白垩高地遮住了远处枪位；洞穴、交通壕和仍在回答的电话，将守军的各个支点连在一起。"),TEXT("阿拉斯的炮声盖过了城里的钟声。沿白垩路推进，肃清高地后方守军，为后续部队打开通路。"),TEXT("阿拉斯前哨的电话只剩杂音。沿白垩路反击，接回失联的枪位，打通后方交通线。"),TEXT("白垩坡上的短交通壕；残雪与雨水弄湿了壕肩。"),19170409,0,EFrontlineMissionTerrainV32::Farmland,0.640f,0.120f,1000.000f,0.300f,0.000f,2,false,false},
    {TEXT("roeux1917"),TEXT("勒厄的接近线"),TEXT("化工厂外的前哨"),TEXT("勒厄守着阿拉斯以东的道路。化工厂、铁路堤和地下掩体彼此照应，炮火打碎的砖墙后仍有机枪；前沿部队正在争夺通向厂区的接近壕。"),TEXT("勒厄化工厂仍在德军手中，残墙间的机枪封锁着接近壕。投弹班清理壕角，步枪掩护穿过最后一段空地。"),TEXT("勒厄化工厂的交通受到威胁。夺回外围接近壕，以破墙间的交叉火力掩护反击。"),TEXT("厂区外围的破墙与沟渠切断长射界，交通壕旁只有狭窄通路。"),19170412,0,EFrontlineMissionTerrainV32::Village,0.600f,0.160f,1040.000f,0.480f,0.040f,2,false,false},
    {TEXT("bullecourt1917"),TEXT("布勒库尔：铁丝的另一面"),TEXT("兴登堡线的壕角"),TEXT("布勒库尔的兴登堡防线前，澳大利亚与英国部队再次集结。四月战斗留下的残骸散在铁丝间，德军纵深壕仍与后方连通；枪榴弹开始落向胸墙。"),TEXT("四月的残骸仍横在布勒库尔铁丝前，澳军再次投入进攻。枪榴弹压住胸墙，步兵夺取中央补给湾，接通送弹道路。"),TEXT("澳军重返布勒库尔，枪榴弹正落向兴登堡线。守住中央补给湾，以分散枪位封锁铁丝缺口。"),TEXT("密集铁丝沿白垩壕肩展开；弹坑提供接近点，也容易聚集火力。"),19170503,0,EFrontlineMissionTerrainV32::Farmland,0.500f,0.080f,1080.000f,0.800f,0.120f,2,false,true},
    {TEXT("messines"),TEXT("梅西讷的破晓"),TEXT("爆破后的山脊"),TEXT("凌晨的地下爆破撕开梅西讷山脊。普卢默的第二集团军沿炮兵计划推进，澳大利亚与新西兰部队也在其中；新弹坑之间，幸存枪位仍在寻找彼此。"),TEXT("凌晨三时十分，地下爆破撕开梅西讷山脊。澳新部队正在邻段推进；机枪跟上坑岸，步兵打通破碎高地。"),TEXT("梅西讷的旧壕道埋在爆破后的碎土里。沿新弹坑收拢守军，夺回补给湾，接通仍在开火的支点。"),TEXT("陡破坑岸与残存反斜面交错，山脊后的补给湾仍可利用。"),19170607,1,EFrontlineMissionTerrainV32::Ridge,0.490f,0.080f,1100.000f,0.450f,0.130f,3,false,true},
    {TEXT("messines_counter1917"),TEXT("把山脊接成一条线"),TEXT("山脊反击令"),TEXT("梅西讷的新前线尚未稳固。英军与澳新部队忙着转向枪口、修补胸墙，德军反击队在东面集合；坑岸上的新路还来不及铺好。"),TEXT("山脊上的新胸墙尚未夯实，东面的反击已经逼近。机枪守住接近线，预备队接应中央阵位。"),TEXT("梅西讷失守两日，反击命令送到前沿。沿坑岸向中央推进；英军预备队仍在高地后方集结。"),TEXT("壕肩尚未完全整修，塌陷处与补给湾把开阔地分成几段。"),19170609,1,EFrontlineMissionTerrainV32::Ridge,0.550f,0.130f,1120.000f,0.560f,0.150f,2,true,false},
    {TEXT("ypres"),TEXT("雨中的皮尔克姆"),TEXT("泥海中的支点"),TEXT("皮尔克姆方向的进攻已经展开。伊普尔周围的排水沟被炮火打断，雨水漫进田野和旧弹坑；送弹队与伤员只能挤向少数仍能通行的道路。"),TEXT("皮尔克姆的排水沟已被炮击切断，送弹队挤上残存木板路。壕炮先到，野炮仍陷在后方；逐个压住湿地中的枪位。"),TEXT("雨水漫过皮尔克姆的旧弹坑。携弹队先把壕炮弹背到前沿，机枪沿尚可通行的硬地换位。"),TEXT("深水弹坑与软泥之间，铁丝分割了少数干燥通路。"),19170731,2,EFrontlineMissionTerrainV32::Marsh,0.970f,0.740f,1220.000f,0.650f,0.180f,3,false,false},
    {TEXT("langemarck1917"),TEXT("朗厄马尔克的混凝土"),TEXT("田野里的堡垒"),TEXT("朗厄马尔克前方，农场废墟和混凝土据点散在湿地里。相邻部队隔着积水接近各自目标，德军机枪沿剩下的干路组织射界；炮兵观察员正在辨认新的落点。"),TEXT("朗厄马尔克的农场只剩混凝土残墙。迫击炮弹正送往前沿补给湾；夺下补给，压住相互照应的枪位。"),TEXT("积水把朗厄马尔克的据点分隔开，中央送弹路仍可通行。守住补给湾，掩护各枪组换防。"),TEXT("狭窄干地绕过深积水，铁丝与掩体形成交错的短射界。"),19170816,2,EFrontlineMissionTerrainV32::Marsh,0.930f,0.580f,1160.000f,0.830f,0.200f,2,false,false},
    {TEXT("menin1917"),TEXT("梅宁路：有限推进"),TEXT("反击走向新的枪口"),TEXT("梅宁路两侧的林地已被炮火削成木桩。英军把炮兵计划集中在有限的推进地段，德军预备队在更深处待命；林缘、坡脊与残存小路决定各枪位能看见什么。"),TEXT("梅宁路两侧只剩焦黑树桩。炮兵集中支援短距离推进，德军预备队仍在纵深等待。夺取中央后，准备迎击反扑。"),TEXT("英军正在梅宁路林缘加固新阵位。气弹已送到炮位，反击队沿掩蔽地段集结。炮火须为接近留出通路。"),TEXT("硬地延伸到破损林缘，壕角与树桩截断射界。"),19170920,2,EFrontlineMissionTerrainV32::Ridge,0.460f,0.060f,1140.000f,0.580f,0.140f,2,true,false},
    {TEXT("cambrai"),TEXT("康布雷的缺口"),TEXT("康布雷：夺回交通线"),TEXT("康布雷近郊的道路与铁路通向一座重要补给枢纽。坚实田地上布满履带印，兴登堡防线的铁丝和纵深壕横在其间；步兵与炮兵正争夺这些接近线。"),TEXT("康布雷的坚实地面承住了 Mark IV 的履带。坦克压过铁丝，步兵清理遗下的壕道，继续向后方交通线推进。"),TEXT("十一月三十日，康布雷反击开始。缴获坦克尚在修理场；步枪与 MG 08/15 打开通路，野炮迎击英军装甲。"),TEXT("坚实田地、长射界与密集兴登堡线铁丝并存。"),19171120,3,EFrontlineMissionTerrainV32::Farmland,0.400f,0.040f,1220.000f,0.800f,0.250f,3,true,false},
    {TEXT("bourlon1917"),TEXT("布尔隆：留住出口"),TEXT("突出部的咽喉"),TEXT("德军反击正挤压康布雷突出部。布尔隆林缘的道路承载着弹药、接替部队和撤出的伤员，英军机枪转向新的威胁；各支部队都在争取让交通继续流动。"),TEXT("布尔隆林缘的撤退纵队越来越长。夺回出口旁的交通壕，让机枪掩护最后一批部队通过。"),TEXT("英军正从布尔隆突出部撤出，新的机枪阵位封住了道路。接通炮兵联络，逐段逼近林缘出口。"),TEXT("被炮火打断的林缘、洼地与狭窄出口使预备队格外重要。"),19171130,3,EFrontlineMissionTerrainV32::Village,0.650f,0.220f,1160.000f,0.620f,0.200f,2,true,false},
    {TEXT("winter_raid1918"),TEXT("冬夜巡逻簿"),TEXT("铁丝前的脚印"),TEXT("冬季的康布雷前线仍在修壕、抓俘和巡逻。雨雪把脚印留在铁丝前，前哨借夜色查看对方是否换防；寂静只持续到第一声枪响。"),TEXT("冬夜巡逻只带轻装装备。沿低地接近前哨，烟幕掩护暴露地段；本次没有装甲、重炮与机队支援。"),TEXT("铁丝前留下了新脚印，前哨尚未回话。轻装分队沿低地接近，烟幕掩护通路；重炮与装甲没有配属。"),TEXT("冬夜的低地潮湿昏暗，浅水散在相近的交通壕之间。"),19180212,3,EFrontlineMissionTerrainV32::Farmland,0.790f,0.280f,1040.000f,0.540f,0.090f,2,false,false},
    {TEXT("michael"),TEXT("雾里的后卫"),TEXT("米夏埃尔：穿过薄弱处"),TEXT("米夏埃尔攻势在浓雾与密集炮火中展开。英军第五集团军守着宽阔正面，德军突击队寻找支点之间的薄弱处；电话交换所与道路交叉口都在遭受轰击。"),TEXT("三月二十一日，米夏埃尔攻势冲破浓雾。第五集团军正在后撤，本连须接通被截断的道路，掩护失散部队归队。"),TEXT("米夏埃尔攻势的炮火向纵深延伸。突击队穿过雾中缺口，A7V 与机枪跟进；中央补给湾关系到后续攻势。"),TEXT("浓雾削短观察距离，旧壕与补给湾仍能维持前后联络。"),19180321,4,EFrontlineMissionTerrainV32::Farmland,0.710f,0.120f,1220.000f,0.440f,0.140f,3,false,true},
    {TEXT("lys1918"),TEXT("利斯河：接上侧翼"),TEXT("乔治特的通路"),TEXT("利斯河低地响起新的德军炮击，葡萄牙与英军阵位正承受进攻。河沟切开了平缓田野，弹药车依赖少数道路；邻段失去联络的消息不断传到连部。"),TEXT("利斯河低地的电话中断，葡萄牙邻段已被突破。沿河沟接起分散支点，夺回道路交叉口。"),TEXT("乔治特攻势穿过河沟与低地。送弹队仍在后方涉水；机枪和突击队须互相接应，打开下一段道路。"),TEXT("平缓低地、河沟与宽泥带把可通行地面分开。"),19180409,1,EFrontlineMissionTerrainV32::Marsh,0.840f,0.370f,1260.000f,0.450f,0.110f,2,false,true},
    {TEXT("villers1918"),TEXT("维莱布勒托讷：钢铁相遇"),TEXT("通向亚眠的村口"),TEXT("维莱布勒托讷扼守通向亚眠的道路。德军步兵与坦克攻向村庄，英国装甲在近郊迎战；破墙、果园和路口之间，双方正争夺能够观察敌车的位置。"),TEXT("德军已攻入维莱布勒托讷，英军坦克正在村外交战。夺回通往亚眠的道路；澳军将在夜间反击。"),TEXT("维莱布勒托讷的进攻已进入村庄，英军坦克从近郊开火。步兵守住装甲两侧，夺取通往亚眠的出口。"),TEXT("破墙、果园残株与道路交叉形成装甲的观察窗口。"),19180424,5,EFrontlineMissionTerrainV32::Village,0.570f,0.080f,1260.000f,0.540f,0.200f,3,true,false},
    {TEXT("amiens"),TEXT("亚眠的低云"),TEXT("八月八日的断线"),TEXT("亚眠清晨的雾里，澳大利亚与加拿大部队向东展开，英军在左侧、法军在南侧行动。炮兵、坦克和航空观察按同一张时刻表工作，德军前沿正设法接回失联枪位。"),TEXT("八月八日清晨，澳大利亚与加拿大部队在亚眠以东推进，法军攻击南侧。坦克随步兵出发，炮火切断守军增援。"),TEXT("亚眠的前沿接连失去联络。缴获坦克与 Tankgewehr 组抵达，机枪掩护后卫；为撤出的部队重新打开交通。"),TEXT("较宽田野和残存村界适合装甲展开，薄雾仍会干扰观察。"),19180808,5,EFrontlineMissionTerrainV32::Farmland,0.480f,0.040f,1300.000f,0.460f,0.150f,3,false,true},
    {TEXT("scarpe1918"),TEXT("越过白垩田野"),TEXT("斯卡尔普的后卫"),TEXT("斯卡尔普方向的推进重新进入白垩田野。加拿大军正越过旧有阵地，德军后卫依托铁丝与村落组织火力；翻出的未爆弹散在工兵要打开的通路上。"),TEXT("斯卡尔普的旧铁丝从白垩土中露出。工兵检查未爆弹，步兵随徐进弹幕穿过缺口。"),TEXT("撤退道路重新穿过旧阵地，铁丝挡住了己方接近线。工兵开路，Wex 分队与机枪掩护局部反击。"),TEXT("白垩断面、残线铁丝与可疑弹药沿田界聚集。"),19180826,6,EFrontlineMissionTerrainV32::Farmland,0.460f,0.080f,1240.000f,0.760f,0.420f,3,false,false},
    {TEXT("hindenburg"),TEXT("里克瓦尔的明渠"),TEXT("守住运河土坡"),TEXT("九月二十九日，英军第四十六师在里克瓦尔附近突击圣康坦运河明渠，夺下未被炸毁的桥。北面的贝利库尔隧道上方，澳大利亚与配属美军同时攻向兴登堡防线。本连负责明渠边的一段接近线；破损土坡、纤道和少数通路决定谁能渡越。"),TEXT("里克瓦尔的运河明渠横在前方。工兵沿破损坡岸接近，法军喷火分遣队清理近处掩体；烟幕掩护渡越。"),TEXT("运河纤道仍能通行，两侧枪位保持联络。工兵照看通路，预备队准备夺回失守的中央阵位。"),TEXT("下挖的明渠、两侧破损土坡和残存纤道贯穿战场；两处降坡通路可供部队渡越。"),19180929,7,EFrontlineMissionTerrainV32::Canal,0.640f,0.130f,1240.000f,0.960f,0.600f,3,true,false},
    {TEXT("selle"),TEXT("切口里的钢铁"),TEXT("塞勒河：留住铁轨"),TEXT("塞勒河的渡口、路堤和铁路切口正在遭受争夺。德军后卫掩护物资与部队后撤，协约国炮兵寻找能压住河谷的观察位置；湿冷天气让每条通路都更加拥挤。"),TEXT("塞勒河切口里的列车仍在掩护撤运。工兵清出接近线，反装甲火力打击车载枪炮，步兵沿路堤展开。"),TEXT("塞勒河车站仍在装车，列车炮组留在切口。步兵掩护车载枪炮的侧翼，守住通往河岸的道路。"),TEXT("湿润河谷被路堤切开，铁轨两侧的旧障碍与浅沟通向狭窄接近线。"),19181017,8,EFrontlineMissionTerrainV32::RailCutting,0.760f,0.250f,1300.000f,0.680f,0.450f,2,false,true},
    {TEXT("valenciennes1918"),TEXT("瓦朗谢讷的门外"),TEXT("城外最后的枪位"),TEXT("加拿大军正在逼近瓦朗谢讷，城镇里仍有平民。守军占住外围道路与枪位，协约国炮兵重新核对射界；军车、手推车与担架共用城外的通路。"),TEXT("瓦朗谢讷城内仍有平民。加拿大军逼近城郊，本连夺取外围道路；毒气与空中轰炸不予配属。"),TEXT("军车与平民挤在瓦朗谢讷城外道路上。后卫守住出口，以烟幕掩护换防；毒气与空中轰炸不予配属。"),TEXT("城边破墙、果园与浅沟形成短射界，火力选择受到限制。"),19181101,6,EFrontlineMissionTerrainV32::Village,0.630f,0.150f,1180.000f,0.400f,0.240f,2,false,false},
    {TEXT("sambre"),TEXT("停战以前的清晨"),TEXT("带回还能归队的人"),TEXT("桑布尔方向的进攻正在展开，新西兰部队已接近勒凯努瓦城墙。运河、居民区和后卫枪位仍挡在前方；西线尚未停火，各连继续接收当天的作战命令。"),TEXT("十一月四日，新西兰部队逼近勒凯努瓦城墙。桑布尔渡口仍在交火；肃清后沿，掩护后续部队通过。城郊禁止毒气与空中轰炸。"),TEXT("南方停战的电报已到，西线仍在开火。机枪守住桑布尔渡口，预备队掩护最后的通路。城郊禁止毒气与空中轰炸。"),TEXT("居民区边缘的壕道通向运河，残余障碍仍需工兵检查。"),19181104,9,EFrontlineMissionTerrainV32::Village,0.680f,0.180f,1220.000f,0.380f,0.280f,3,false,false},
