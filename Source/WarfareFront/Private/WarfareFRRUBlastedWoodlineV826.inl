inline bool ValidateComponent(const FString& Scene,const UStaticMeshComponent* Component)
{
    if(!Enabled(Scene)||!Component||!Component->ComponentHasTag(TEXT("FRRU_V826BlastedWoodline"))
        ||!Component->IsRegistered()||!Component->IsVisible()
        ||Component->GetCollisionEnabled()!=ECollisionEnabled::NoCollision)return false;
    const auto* Instances=Cast<UHierarchicalInstancedStaticMeshComponent>(Component);
    const UStaticMesh* Mesh=Component->GetStaticMesh();if(!Instances||!Mesh)return false;
    int32 Index=INDEX_NONE;for(int32 I=0;I<6;++I)if(Mesh->GetPathName()==MeshPaths[I]){Index=I;break;}
    if(Index==INDEX_NONE)return false;
    int32 ExpectedInstances=0;for(const auto& P:Placements)ExpectedInstances+=P.Mesh==Index;
    if(ExpectedInstances<=0||Instances->GetInstanceCount()!=ExpectedInstances)return false;
    int32 Instance=0;
    for(const auto& P:Placements)if(P.Mesh==Index)
    {
        FTransform Actual;
        if(!Instances->GetInstanceTransform(Instance++,Actual,true))return false;
        // ISM stores a matrix; UE assigns a reflected matrix's negative scale
        // to X when reconstructing it. Compare the final geometry transform,
        // not an equivalent quaternion/signed-scale decomposition.
        const FMatrix ActualMatrix=Actual.ToMatrixWithScale(),ExpectedMatrix=P.World.ToMatrixWithScale();
        const double ActualDet=ActualMatrix.Determinant(),ExpectedDet=ExpectedMatrix.Determinant();
        if(ActualMatrix.ContainsNaN()||ExpectedMatrix.ContainsNaN()||!FMath::IsFinite(ActualDet)
            ||!FMath::IsFinite(ExpectedDet)||ActualDet<=0.||ExpectedDet<=0.
            ||!ActualMatrix.Equals(ExpectedMatrix,.0001f))
        {
            double MaxDelta=0.;for(int32 Row=0;Row<4;++Row)for(int32 Col=0;Col<4;++Col)
                MaxDelta=FMath::Max(MaxDelta,FMath::Abs(ActualMatrix.M[Row][Col]-ExpectedMatrix.M[Row][Col]));
            UE_LOG(LogTemp,Error,TEXT("WF_BLASTED_WOODLINE_MATRIX mesh=%d instance=%d maxDelta=%.17g actualDet=%.17g expectedDet=%.17g"),
                Index,Instance-1,MaxDelta,ActualDet,ExpectedDet);
            return false;
        }
    }
    if(Component->GetNumMaterials()!=Mesh->GetStaticMaterials().Num())return false;
    for(int32 Slot=0;Slot<Component->GetNumMaterials();++Slot)
    {
        const auto* Material=Component->GetMaterial(Slot);bool Matched=false;
        for(const auto& C:Materials)if(C.Mesh==Index&&Mesh->GetStaticMaterials()[Slot].MaterialSlotName==FName(C.Slot)
            &&Material&&Material->GetPathName()==C.Path){Matched=true;break;}
        if(!Matched)return false;
    }
    return true;
}
inline bool Stage(AActor* Owner,USceneComponent* Root,const FString& SceneId,FString& Error)
{
    if(!Enabled(SceneId))return true;
    const auto* Native=wfexp::scene::ForMission("fr.malmaison");
    if(!Owner||!Root||Owner->GetRootComponent()!=Root||!Native||Native->revision!=1||Native->heightCount!=131841)
    {Error=TEXT("blasted woodline native/root identity mismatch");return false;}
    uint64 Hash=14695981039346656037ull;
    for(std::size_t I=0;I<Native->heightCount;++I)
    {const uint16 V=static_cast<uint16>(Native->heightsCm[I]);Hash=(Hash^uint8(V))*1099511628211ull;Hash=(Hash^uint8(V>>8))*1099511628211ull;}
    if(Hash!=1417540245652055815ull){Error=TEXT("blasted woodline requires the verified active native terrain");return false;}
    UStaticMesh* Meshes[6]={};
    for(int32 I=0;I<6;++I)
    {
        Meshes[I]=LoadObject<UStaticMesh>(nullptr,MeshPaths[I]);
        if(!Meshes[I]||!Meshes[I]->GetRenderData()||Meshes[I]->GetStaticMaterials().IsEmpty())
        {Error=TEXT("retained blasted woodline mesh/material missing");return false;}
        const FBox Bounds=Meshes[I]->GetBoundingBox();
        if(!Bounds.Min.Equals(ExpectedBounds[I].Min,.05)||!Bounds.Max.Equals(ExpectedBounds[I].Max,.05))
        {Error=TEXT("retained blasted woodline actual bounds differ");return false;}
        for(const auto& Slot:Meshes[I]->GetStaticMaterials())
        {
            bool Matched=false;for(const auto& C:Materials)
                if(C.Mesh==I&&Slot.MaterialSlotName==FName(C.Slot)&&Slot.MaterialInterface
                    &&Slot.MaterialInterface->GetMaterial()&&Slot.MaterialInterface->GetPathName()==C.Path){Matched=true;break;}
            if(!Matched){Error=TEXT("retained blasted woodline material differs");return false;}
        }
    }
    // Real source body vertices, final transformed XY, actual native triangles.
    // No source branch-minimum substitute, blind base offset or terrain query cache.
    for(const auto& P:Placements)for(int32 J=0;J<P.BearingCount;++J)
    {
        const auto& B=Bearings[P.FirstBearing+J];const FVector W=P.World.TransformPosition(B.Local);
        double H=0;
        if(!wfexp::scene::HeightAt(*Native,W.X,W.Y,H)||FMath::Abs(H-B.NativeHeight)>.001
            ||FMath::Abs((W.Z-H)-B.ExpectedGap)>.001||W.Z>H-2.999||W.Z<H-28.001)
        {Error=TEXT("blasted woodline actual body-bearing contact differs");return false;}
    }
    UHierarchicalInstancedStaticMeshComponent* Components[6]={};
    for(int32 I=0;I<6;++I)
    {
        auto* C=NewObject<UHierarchicalInstancedStaticMeshComponent>(Owner,
            FName(*FString::Printf(TEXT("MalmaisonBlastedWoodlineV826_%d"),I)),RF_Transient);
        Owner->AddInstanceComponent(C);C->SetupAttachment(Root);C->SetMobility(EComponentMobility::Movable);C->SetStaticMesh(Meshes[I]);
        C->SetCollisionProfileName(TEXT("NoCollision"));C->SetCollisionEnabled(ECollisionEnabled::NoCollision);
        C->SetGenerateOverlapEvents(false);C->SetCanEverAffectNavigation(false);C->SetReceivesDecals(true);
        C->ComponentTags.Add(TEXT("FRRU_V826BlastedWoodline"));C->RegisterComponent();Components[I]=C;
    }
    for(const auto& P:Placements)Components[P.Mesh]->AddInstance(P.World.GetRelativeTransform(Owner->GetActorTransform()));
    for(const auto* C:Components)if(!ValidateComponent(SceneId,C))
    {Error=TEXT("blasted woodline actual staging contract failed");return false;}
    return true;
}
