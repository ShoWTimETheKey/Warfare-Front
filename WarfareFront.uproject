{
  "FileVersion": 3,
  "EngineAssociation": "5.8",
  "Category": "Games",
  "Description": "A single-front 1917 trench battle: reinforcements, timed assaults, fire support and morale.",
  "Modules": [
    { "Name": "WarfareFront", "Type": "Runtime", "LoadingPhase": "PostConfigInit" },
    { "Name": "WarfareFrontStartup", "Type": "Runtime", "LoadingPhase": "PostSplashScreen" }
  ],
  "Plugins": [
    { "Name": "EnhancedInput", "Enabled": true },
    { "Name": "PythonScriptPlugin", "Enabled": true, "TargetAllowList": ["Editor"] },
    { "Name": "EditorScriptingUtilities", "Enabled": true, "TargetAllowList": ["Editor"] },
    { "Name": "UdpMessaging", "Enabled": false },
    { "Name": "TcpMessaging", "Enabled": false },
    { "Name": "DLSS", "Enabled": true },
    { "Name": "StreamlineDLSSG", "Enabled": true },
    { "Name": "StreamlineReflex", "Enabled": true },
    { "Name": "Reflex", "Enabled": false }
  ],
  "TargetPlatforms": ["Windows"]
}
